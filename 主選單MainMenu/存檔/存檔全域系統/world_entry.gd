
extends Node

# ============================================================
# 《眠境 RE:RECOLOR》
# WorldEntry V1｜遊戲世界進場管理器
#
# 適用版本：Godot 4.5.1
# Autoload 名稱：WorldEntry
#
# ============================================================
# 職責
# ============================================================
#
# 1. 接收主選單的讀取存檔要求
# 2. 檢查指定存檔是否可以載入
# 3. 將存檔地圖 ID 轉換為實際場景路徑
# 4. 將存檔出生點 ID 轉換為場景 Marker2D
# 5. 呼叫 SaveManager 載入正式存檔資料
# 6. 將地圖切換交給既有的 SceneTransition
# 7. 防止重複觸發進場
#
# ============================================================
# 不負責
# ============================================================
#
# - 直接讀寫 JSON
# - 建立新存檔
# - 操作主選單 UI
# - 播放黑幕動畫
# - 計算普通傳送門出口
# - 畫架之間的快速傳送
# - 玩家死亡及重生
#
# 以上交給其他專門系統。
#
# ============================================================
# 相容性
# ============================================================
#
# 目前已建立的 Slot 01 使用舊暫定資料：
#
# map_id  = first_land_sakura_garden
# easel_id = easel_start_01
#
# 但 AM001 實際沒有畫架。
#
# 因此 V1 將這組已知的舊 ID
# 明確對應到 NewGameSpawnPoint。
#
# 不會修改或刪除 slot_01.json。
#
# 未來會由正式的 CheckpointManager
# 管理畫架 ID 與出生點的對應。
# ============================================================


# ============================================================
# 1. 對外訊號
# ============================================================

## 已通過前置檢查，並向轉場系統送出進場要求
##
## 注意：
## 這不等於地圖已經完成載入。
signal entry_requested(
	slot_id: int,
	map_id: String
)

## 進場要求被拒絕
signal entry_rejected(
	slot_id: int,
	reason: String
)


# ============================================================
# 2. 地圖 ID 對照表
#
# 存檔只保存穩定 ID，
# 不保存容易因專案重構而改變的場景路徑。
#
# 未來新增地圖時會擴充這份對照表。
#
# 目前只登記已確認的 AM001，
# 不猜測其他地圖的實際用途。
# ============================================================

const MAP_SCENE_PATHS: Dictionary = {

	"first_land_sakura_garden":
		"res://Maps/AM001.tscn"
}


# ============================================================
# 3. 目前已知的初始出生點
# ============================================================

const INITIAL_MAP_ID: String = (
	"first_land_sakura_garden"
)

const INITIAL_LEGACY_EASEL_ID: String = (
	"easel_start_01"
)

const INITIAL_SPAWN_NAME: String = (
	"NewGameSpawnPoint"
)


# ============================================================
# 4. 內部操作狀態
#
# 防止玩家連續點擊同一個存檔時，
# 重複發送進場要求。
# ============================================================

var _entry_pending: bool = false


# ============================================================
# 5. 正式讀檔進場入口
#
# 由主選單 MenuActions 呼叫。
#
# 回傳：
#
# true：
# 存檔讀取成功，已送出轉場要求。
#
# false：
# 前置檢查失敗，沒有開始轉場。
#
# 重要：
# true 不代表玩家已經完成地圖載入。
# ============================================================

func load_existing_slot(
	slot_id: int
) -> bool:

	# --------------------------------------------------------
	# A. 防止重複操作
	# --------------------------------------------------------

	if _entry_pending:

		return _reject(
			slot_id,
			"已有尚未完成的進場要求"
		)

	if SceneTransition.is_transitioning:

		return _reject(
			slot_id,
			"場景正在切換"
		)

	# --------------------------------------------------------
	# B. 檢查存檔是否正常
	#
	# 本階段僅允許 READY 存檔。
	#
	# RECOVERABLE 需要先完成正式備份復原，
	# 不可直接當成正常紀錄進入遊戲。
	# --------------------------------------------------------

	if (
		SaveManager.get_slot_state(slot_id)
		!= SaveManager.SlotState.READY
	):

		return _reject(
			slot_id,
			"指定欄位沒有可正常載入的存檔"
		)

	# --------------------------------------------------------
	# C. 取得存檔摘要
	#
	# 先檢查地圖路由是否存在，
	# 再正式變更 SaveManager 的目前存檔。
	# --------------------------------------------------------

	var summary: Dictionary = (
		SaveManager.get_slot_summary(slot_id)
	)

	var map_id: String = str(
		summary.get("map_id", "")
	)

	var easel_id: String = str(
		summary.get("easel_id", "")
	)

	# --------------------------------------------------------
	# D. 解析場景路徑
	# --------------------------------------------------------

	var scene_path: String = (
		_resolve_map_scene(map_id)
	)

	if scene_path.is_empty():

		return _reject(
			slot_id,
			"找不到地圖 ID 對應的場景：" + map_id
		)

	# --------------------------------------------------------
	# E. 驗證場景資源存在
	#
	# 避免直接切換到不存在的檔案路徑。
	# --------------------------------------------------------

	if not ResourceLoader.exists(scene_path):

		return _reject(
			slot_id,
			"地圖場景資源不存在：" + scene_path
		)

	# --------------------------------------------------------
	# F. 解析出生點
	# --------------------------------------------------------

	var spawn_name: String = (
		_resolve_spawn_name(
			map_id,
			easel_id
		)
	)

	if spawn_name.is_empty():

		return _reject(
			slot_id,
			"尚未登記出生點：" + easel_id
		)

	# --------------------------------------------------------
	# G. 鎖定進場操作
	# --------------------------------------------------------

	_entry_pending = true

	# --------------------------------------------------------
	# H. 正式讀取存檔
	#
	# SaveManager 會更新：
	# - current_slot_id
	# - _current_data
	#
	# 若載入失敗，不能進入地圖。
	# --------------------------------------------------------

	var loaded: bool = (
		SaveManager.load_slot(slot_id)
	)

	if not loaded:

		_entry_pending = false

		return _reject(
			slot_id,
			"SaveManager 讀取存檔失敗"
		)

	# --------------------------------------------------------
	# I. 清除不屬於本次操作的快速傳送旗標
	#
	# 讀取主選單存檔，不等於使用畫架快速傳送。
	#
	# 避免 BaseMap 誤將玩家移到 PortalSpawnPoint。
	#
	# 這裡只清除旗標，不修改其他傳送程式。
	# --------------------------------------------------------

	DataManager.is_teleporting = false

	# --------------------------------------------------------
	# J. 發送進場要求訊號
	# --------------------------------------------------------

	entry_requested.emit(
		slot_id,
		map_id
	)

	print(
		"【WorldEntry】讀取 Slot %02d" % slot_id
	)

	print(
		"【WorldEntry】目標地圖：",
		scene_path
	)

	print(
		"【WorldEntry】目標出生點：",
		spawn_name
	)

	# --------------------------------------------------------
	# K. 交給既有 SceneTransition
	#
	# 不建立第二套黑幕或地圖切換器。
	#
	# 最後一個參數為 Vector2.ZERO，
	# 代表不強制改變阿尼的面向。
	# --------------------------------------------------------

	SceneTransition.change_map(
		scene_path,
		spawn_name,
		Vector2.ZERO
	)

	# 已正式送出轉場要求。
	#
	# 下一階段會配合 SceneTransition 的完成訊號，
	# 區分真正進場成功和失敗。
	#
	# 現階段此函式通常從主選單執行，
	# 主選單在轉場後會被卸載。
	_entry_pending = false

	return true


# ============================================================
# 6. 地圖 ID 轉場景路徑
#
# 避免在不同 UI 中重複硬編碼場景路徑。
# ============================================================

func _resolve_map_scene(
	map_id: String
) -> String:

	return str(
		MAP_SCENE_PATHS.get(
			map_id,
			""
		)
	)


# ============================================================
# 7. 出生點 ID 對照
#
# V1 僅支援已確認的初始地圖。
#
# 因 AM001 尚未有畫架，
# 所以將舊存檔的暫定畫架 ID
# 對應到真正的新遊戲出生點。
#
# 不會將所有未知畫架一律導向起點。
# 這是為了避免錯誤存檔悄悄進入錯誤位置。
# ============================================================

func _resolve_spawn_name(
	map_id: String,
	easel_id: String
) -> String:

	# --------------------------------------------------------
	# 已知舊紀錄：AM001 初始位置
	# --------------------------------------------------------

	if (
		map_id == INITIAL_MAP_ID
		and easel_id == INITIAL_LEGACY_EASEL_ID
	):

		return INITIAL_SPAWN_NAME

	# --------------------------------------------------------
	# 未登記的畫架／地圖
	#
	# 未來由正式 CheckpointManager 處理。
	# --------------------------------------------------------

	return ""


# ============================================================
# 8. 統一拒絕操作
#
# 目前只記錄錯誤，不修改存檔或場景。
# ============================================================

func _reject(
	slot_id: int,
	reason: String
) -> bool:

	var message: String = (
		"【WorldEntry】Slot %02d 無法進場：%s"
		% [
			slot_id,
			reason
		]
	)

	push_warning(message)

	entry_rejected.emit(
		slot_id,
		reason
	)

	return false
